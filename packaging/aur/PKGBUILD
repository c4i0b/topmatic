# Maintainer: Caio <caio@example.com>

pkgname=topmatic
pkgver=1.2.0
pkgrel=1
pkgdesc="User-level scheduled updates powered by topgrade"
arch=('x86_64')
url="https://github.com/c4i0b/topmatic"
license=('MIT')
options=(!debug)
depends=('topgrade' 'gcc-libs')
makedepends=('cargo' 'rust')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b49ab01a2dfecd0a584c2547466529936e62a5fb99e388c3b7669943f6dd4418')

prepare() {
  cd "$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "$srcdir/target/release/topmatic" "$pkgdir/usr/bin/topmatic"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
